{
    "name": "webisters/cache",
    "description": "Webisters Cache Library",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "cache",
        "database",
        "files",
        "memcached",
        "redis",
        "igbinary",
        "json",
        "json-array",
        "msgpack",
        "psr-16",
        "simple-cache"
    ],
    "authors": [
        {
            "name": "Hafiz Muhammad Moaz",
            "email": "hafizmoazkhalid@gmail.com",
            "homepage": "https://github.com/HafizMMoaz"
        }
    ],
    "homepage": "https://webisters.com/packages/cache",
    "support": {
        "email": "support@webisters.com",
        "issues": "https://github.com/webisters/cache/issues",
        "forum": "https://github.com/webisters/forum",
        "source": "https://github.com/webisters/cache",
        "docs": "https://webisters.com"
    },
    "funding": [
        {
            "type": "Webisters Sponsor",
            "url": "https://webisters.com/sponsor"
        }
    ],
    "require": {
        "php": ">=8.2",
        "ext-json": "*",
        "webisters/debug": "*",
        "webisters/log": "*"
    },
    "require-dev": {
        "jetbrains/phpstorm-attributes": "^1.0",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^10.5",
        "psr/simple-cache": "^3.0",
        "webisters/coding-standard": "*",
        "webisters/database": "*"
    },
    "suggest": {
        "psr/simple-cache": "Required by the SimpleCache adapter, to hand this cache to a library that asks for PSR-16",
        "webisters/database": "Required by the DatabaseCache driver, for a cache that survives restarts"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Framework\\Cache\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\Cache\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "scripts": {
        "analyse": "phpstan analyse",
        "lint": "php-cs-fixer fix --dry-run --diff",
        "lint:fix": "php-cs-fixer fix",
        "test": "phpunit",
        "check": [
            "@lint",
            "@analyse",
            "@test"
        ]
    },
    "scripts-descriptions": {
        "analyse": "Run PHPStan static analysis",
        "lint": "Check the coding standard without changing anything",
        "lint:fix": "Apply the coding standard",
        "test": "Run the PHPUnit suite",
        "check": "Run the coding standard, the static analysis and the suite"
    }
}
